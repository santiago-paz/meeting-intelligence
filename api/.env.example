# Copy to .env for local development. Matches the db service in docker-compose.yml.
DATABASE_URL=postgresql://meetings:meetings@localhost:5432/meetings

# Required to ingest: context headers are written by Claude. Without it,
# POST /meetings answers 503 and everything else keeps working.
ANTHROPIC_API_KEY=

# Optional overrides.
# CLAUDE_BASE_URL=https://api.anthropic.com
# CONTEXT_HEADER_MODEL=claude-haiku-4-5
# ANSWER_MODEL=claude-opus-5
# EXTRACTION_MODEL=claude-opus-5
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
